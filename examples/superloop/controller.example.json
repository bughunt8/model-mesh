{
  "version": 1,
  "mode": "shadow",
  "note": "Shadow pilot. The decision model's answers are logged next to the rules baseline and change nothing. Real provider and model IDs appear only in this example file. The goose reviewer argv is a sketch: its recipe and --params flags were not checked against a goose install.",
  "caps": {"max_iterations": 10, "wall_clock_seconds": 1800, "no_progress_streak": 2, "fix_verify_cycles": 3, "per_call_seconds": 600, "budget_usd": 5.0},
  "reservations_usd": {"worker_call": 0.4, "review_call": 0.15, "decision_call": 0.001},
  "review": {"every_k_iterations": 0, "smoke_below": 0.5},
  "decision": {
    "backend": {"kind": "http", "base_url": "https://api.typesafe.ai", "path": "/v1/systemone", "model": "jev-1.14.0", "api_key_env": "TYPESAFE_API_KEY", "state_encoding": "object", "timeout_seconds": 10, "retries": 2},
    "questions": "examples/superloop/questions.json",
    "budget_tokens": 30000,
    "locale": "en",
    "lineage": {"provider": "typesafe", "model": "jev-1.14.0", "base_family": "undisclosed"},
    "egress": {"hk_reachable_verified": false, "retention": "DPA keeps data as long as necessary for the purpose; zero data retention by enterprise agreement only", "region": "United States, per the launch post"}
  },
  "qualifications": [],
  "worker": {"kind": "omo", "binary": "./node_modules/.bin/oh-my-openagent", "pinned_version": "4.19.4", "agent": "sisyphus", "expect_agents": ["sisyphus", "Sisyphus - ultraworker"], "env": {}},
  "materialize": {"fragment": "profiles/hybrid.example.json", "disabled_hooks": ["goal", "todo-continuation-enforcer", "start-work", "atlas"]},
  "reviewers": [
    {"harness": "goose", "kind": "command", "tag": "review-goose", "argv": ["goose", "run", "--recipe", "review.recipe.yaml", "--params", "diff={diff_file}", "--params", "findings={findings_out}", "--params", "lenses={lenses}"], "env": {"GOOSE_MODE": "approve"}}
  ]
}
