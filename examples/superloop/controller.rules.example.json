{
  "version": 1,
  "mode": "shadow",
  "note": "Offline baseline. Rules answer every question, so no request leaves the machine. Use it to collect the run log a decision model has to beat.",
  "caps": {
    "max_iterations": 10,
    "wall_clock_seconds": 1800,
    "no_progress_streak": 2,
    "fix_verify_cycles": 3,
    "per_call_seconds": 600,
    "budget_usd": 5.0
  },
  "reservations_usd": {
    "worker_call": 0.4,
    "review_call": 0.15,
    "decision_call": 0.001
  },
  "review": {
    "every_k_iterations": 0,
    "smoke_below": 0.5
  },
  "decision": {
    "backend": {
      "kind": "rules"
    },
    "questions": "examples/superloop/questions.json",
    "budget_tokens": 30000,
    "locale": "en",
    "lineage": {
      "provider": "none",
      "model": "rules",
      "base_family": "none"
    },
    "egress": {
      "retention": "local only",
      "region": "local"
    }
  },
  "qualifications": [],
  "worker": {
    "kind": "omo",
    "ref": "omo-4.19.4",
    "agent": "sisyphus",
    "expect_agents": [
      "sisyphus",
      "Sisyphus - ultraworker"
    ],
    "isolation": "bwrap",
    "env": {}
  },
  "repository": "model-mesh",
  "check_jail": "bwrap",
  "materialize": {
    "fragment": "profiles/hybrid.example.json",
    "disabled_hooks": [
      "goal",
      "todo-continuation-enforcer",
      "start-work",
      "atlas",
      "runtime-fallback"
    ]
  },
  "reviewers": [
    {
      "harness": "goose",
      "kind": "command",
      "ref": "goose-review"
    }
  ]
}
